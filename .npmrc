shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# This UI workspace runs two React majors side by side: the vendored
# @redrob-labs/ui design system supports React 18 and 19, while the ported
# @genoffice/* apps (docs/shell) are React 19. pnpm's default virtual-store
# hoist puts the highest @types/react (19.x) into .pnpm/node_modules, where
# @tiptap/react's bundled .d.ts resolves it - which makes a React-18 typecheck
# see React 19's ReactNode (bigint) and fail. Excluding @types/react* from the
# hoist forces every consumer to resolve @types/react from its own peer set,
# keeping the two majors isolated.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom

# NOTE: the @redrob-labs scope is NOT fetched from GitHub Packages here. The
# design system (@redrob-labs/ui) is vendored under vendor/redrob-ui and
# resolved via the pnpm workspace, so no private registry auth is required.
