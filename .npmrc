shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# redrob-office runs two React majors side by side: the existing @redrob/office
# app is React 18 while the ported @genoffice/* apps (docs/shell) are React 19.
# pnpm's default virtual-store hoist puts the highest @types/react (19.x) into
# .pnpm/node_modules, where @tiptap/react's bundled .d.ts resolves it - which
# makes the office (React 18) typecheck see React 19's ReactNode (bigint) and
# fail. Excluding @types/react* from the hoist forces every consumer to resolve
# the @types/react from its own peer set (18 for office, 19 for the docs/shell
# apps), keeping the two majors isolated. See FEAT-003 findings.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
