{
  "name": "@genoffice/markdown",
  "productName": "Redrob Markdown",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Markdown editor module (UI only): a TipTap block editor over plain .md, rendered standalone in the browser. The Electron main process, preload bridge and file I/O are removed; backend seams are stubbed via src/renderer/ui-stubs.ts.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/agent-core": "workspace:*",
    "@genoffice/ai-provider": "workspace:*",
    "@genoffice/docx-engine": "workspace:*",
    "@genoffice/electron-utils": "workspace:*",
    "@genoffice/i18n": "workspace:*",
    "@genoffice/project-store": "workspace:*",
    "@genoffice/ui": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-mathematics": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "katex": "^0.16.47",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Redrob"
}
