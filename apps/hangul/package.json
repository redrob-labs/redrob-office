{
  "name": "@genoffice/hangul",
  "productName": "Redrob Hangul",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Hangul (.hwp/.hwpx) editor module: embeds the rhwp-studio editor (MIT) via the @rhwp/editor iframe SDK, hosted by shell tabs and served from a local offline origin",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@genoffice/electron-utils": "workspace:*",
    "@genoffice/i18n": "workspace:*",
    "@genoffice/ui": "workspace:*",
    "@rhwp/editor": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Redrob"
}
