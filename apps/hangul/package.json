{
  "name": "@genoffice/hangul",
  "productName": "Redrob Hangul",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Hangul (.hwp/.hwpx) editor module (UI only, LIVE engine): the owned editor (@genoffice/hwp-editor) over the hwp-core WASM engine runs in the renderer, so the editor is fully functional in the browser. Only the Electron main process, preload bridge and file-byte IO / sync / AI are removed; those seams are stubbed via src/renderer/ui-stubs.ts.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/agent-core": "workspace:*",
    "@genoffice/ai-provider": "workspace:*",
    "@genoffice/electron-utils": "workspace:*",
    "@genoffice/hwp-core": "workspace:*",
    "@genoffice/hwp-editor": "workspace:*",
    "@genoffice/i18n": "workspace:*",
    "@genoffice/sync-client": "workspace:*",
    "@genoffice/ui": "workspace:*",
    "@genoffice/versions": "workspace:*",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Redrob"
}
