    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/ai-provider": "workspace:*",
    "@genoffice/electron-utils": "workspace:*",
    "@genoffice/facts": "workspace:*",
    "@genoffice/i18n": "workspace:*",
    "@genoffice/identity": "workspace:*",
    "@genoffice/sync-client": "workspace:*",
    "@genoffice/ui": "workspace:*",
    "@genoffice/versions": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Redrob"
}
