{
  "name": "@genoffice/shell",
  "productName": "Redrob Office",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/redrob-labs/redrob-office",
  "private": true,
  "description": "Unified Redrob shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "redrob.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@genoffice/agent-core": "workspace:*",
    "@genoffice/ai-provider": "workspace:*",
    "@genoffice/ai-search": "workspace:*",
    "@genoffice/docs": "workspace:*",
    "@genoffice/docx-engine": "workspace:*",
    "@genoffice/electron-utils": "workspace:*",
    "@genoffice/hangul": "workspace:*",
    "@genoffice/i18n": "workspace:*",
    "@genoffice/pptx-engine": "workspace:*",
    "@genoffice/pptx-render": "workspace:*",
    "@genoffice/project-store": "workspace:*",
    "@genoffice/sheets": "workspace:*",
    "@genoffice/slides": "workspace:*",
    "@genoffice/ui": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "undici": "^6.28.0"
  },
  "author": "Redrob"
}
