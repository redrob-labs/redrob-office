{
  "name": "@genoffice/shell",
  "productName": "Redrob Office",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/redrob-labs/redrob-office",
  "private": true,
  "description": "Redrob Office suite shell (UI only): the host window chrome - home screen, tab bar, settings - rendered standalone in the browser. The Electron main process, window/tab orchestration, engine custody and file I/O are removed; the backend seams are stubbed via src/renderer/src/ui-stubs.ts.",
