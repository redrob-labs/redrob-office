{
  "name": "@redrob/office",
  "version": "0.0.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Redrob Office Electron shell",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:cdp": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "dist": "pnpm run dist:win",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.yml --win",
    "dist:win:dir": "pnpm run build && electron-builder --config electron-builder.yml --win --dir",
    "dist:mac": "pnpm run build && electron-builder --config electron-builder.yml --mac",
    "dist:mac:dir": "pnpm run build && electron-builder --config electron-builder.yml --mac --dir",
    "dist:dir": "pnpm run dist:win:dir",
    "publish:test": "pnpm run build && electron-builder --config electron-builder.yml --win --publish always",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "office:bench:minimized": "node ./scripts/run-electron-ts.mjs ./scripts/floor-bench-main.ts",
    "clean": "rimraf out dist release",
    "daylog:focus-e2e": "node ./scripts/run-electron-ts.mjs ./scripts/day-log-focus-e2e.ts",
    "browser:focus-e2e": "node ./scripts/run-electron-ts.mjs ./scripts/browser-focus-e2e.ts"
  },
  "dependencies": {
    "@redrob/compare": "workspace:*",
    "@redrob/extract": "workspace:*",
    "@redrob/generate": "workspace:*",
    "@redrob/kernel": "workspace:*",
    "@redrob/registry": "workspace:^",
    "@redrob/store": "workspace:*",
    "@redrob/telemetry": "workspace:*",
    "@redrob/ui": "workspace:*",
    "@rhwp/core": "^0.8.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "docx-preview": "^0.3.6",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "koffi": "^3.1.4",
    "marked": "^18.0.9",
    "pino": "^9.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "node-gyp": "^13.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
