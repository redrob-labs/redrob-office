{
  "name": "redrob-office-ui",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Redrob Office — UI/UX layer. The renderer (React) surfaces of the office suite (Docs, Sheets, Slides, Markdown, PDF, Hangul) plus the shared design system, extracted to run without the Electron desktop backend. The Sheets (Univer) and Hangul (hwp-core/hwp-editor) editing engines are retained so those editors remain functional; all other backend (Electron main process, IPC bridges, file I/O, AI transport, sync, identity, persistence) is removed or stubbed.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "check:ui-tokens": "node scripts/check-ui-tokens.mjs",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": "1.42.1",
      "@types/react@^19": "19.2.17",
      "@types/react-dom@^19": "19.2.3",
      "@fluentui/react-icons": "2.0.333",
      "react-konva": "19.2.5",
      "@univerjs/core": "0.25.1",
      "@univerjs/design": "0.25.1",
      "@univerjs/docs": "0.25.1",
      "@univerjs/docs-ui": "0.25.1",
      "@univerjs/engine-formula": "0.25.1",
      "@univerjs/engine-render": "0.25.1",
      "@univerjs/rpc": "0.25.1",
      "@univerjs/sheets": "0.25.1",
      "@univerjs/sheets-formula": "0.25.1",
      "@univerjs/sheets-ui": "0.25.1",
      "@univerjs/ui": "0.25.1",
      "@univerjs/docs-drawing": "0.25.1",
      "@univerjs/docs-drawing-ui": "0.25.1",
      "@univerjs/drawing": "0.25.1",
      "@univerjs/drawing-ui": "0.25.1",
      "@univerjs/engine-numfmt": "0.25.1",
      "@univerjs/find-replace": "0.25.1",
      "@univerjs/network": "0.25.1",
      "@univerjs/protocol": "0.25.1",
      "@univerjs/telemetry": "0.25.1",
      "@univerjs/themes": "0.25.1",
      "@univerjs/data-validation": "0.25.1",
      "@univerjs/sheets-conditional-formatting": "0.25.1",
      "@univerjs/sheets-data-validation": "0.25.1",
      "@univerjs/sheets-data-validation-ui": "0.25.1",
      "@univerjs/sheets-drawing": "0.25.1",
      "@univerjs/sheets-drawing-ui": "0.25.1",
      "@univerjs/sheets-filter": "0.25.1",
      "@univerjs/sheets-filter-ui": "0.25.1",
      "@univerjs/sheets-find-replace": "0.25.1",
      "@univerjs/sheets-formula-ui": "0.25.1",
      "@univerjs/sheets-hyper-link": "0.25.1",
      "@univerjs/sheets-hyper-link-ui": "0.25.1",
      "@univerjs/sheets-note": "0.25.1",
      "@univerjs/sheets-note-ui": "0.25.1",
      "@univerjs/sheets-numfmt": "0.25.1",
      "@univerjs/sheets-numfmt-ui": "0.25.1",
      "@univerjs/sheets-sort": "0.25.1",
      "@univerjs/sheets-sort-ui": "0.25.1",
      "@univerjs/sheets-table": "0.25.1",
      "@univerjs/sheets-table-ui": "0.25.1",
      "@univerjs/sheets-conditional-formatting-ui": "0.25.1",
      "@univerjs/sheets-zen-editor": "0.25.1"
    },
    "packageExtensions": {
      "@fluentui/react-icons": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@redrob-labs/ui": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-konva": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
