{
  "name": "redrob-office",
  "private": true,
  "version": "0.8.3",
  "license": "Apache-2.0",
  "description": "On-device office suite: lookup, process, and review without leaving this PC",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "node ./scripts/ensure-electron.mjs",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@genoffice/shell",
    "test": "turbo run test",
    "audit:i18n": "node ./scripts/audit-i18n.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "dist": "pnpm build && pnpm --filter @genoffice/shell dist:linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "harfbuzzjs": "^1.5.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "prosemirror-view": "1.42.1",
      "@types/react@^19": "19.2.17",
      "@types/react-dom@^19": "19.2.3",
      "@fluentui/react-icons": "2.0.333",
      "react-konva": "19.2.5"
    },
    "packageExtensions": {
      "@fluentui/react-icons": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-konva": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
