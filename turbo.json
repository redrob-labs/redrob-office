{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "out/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "env": [
        "HWP_LIVE_FUZZ_ROUNDS"
      ],
      "passThroughEnv": [
        "REDROB_CODE_BIN",
        "REDROB_CODE_BUN",
        "REDROB_CODE_DEV_ROOT"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "REDROB_CODE_BIN",
    "REDROB_CODE_BUN",
    "REDROB_CODE_DEV_ROOT",
    "RUSTUP_HOME",
    "CARGO_HOME",
    "GENOFFICE_USER_DATA"
  ]
}
