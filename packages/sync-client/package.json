    "./node": "./src/shared-index.ts",
    "./live": "./src/live.ts",
    "./live-provider": "./src/live-provider.ts",
    "./live-models": "./src/live-models.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
